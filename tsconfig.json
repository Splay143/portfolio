{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",

        "rootDir": "src",
        "outDir": "dist",

        "strict": true,
        "noEmitOnError": true,

        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts"
    ]
}